# Copy to .env and fill in.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ecoquest?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Public URL of the app. Required in production: used in confirmation-email and invite links.
AUTH_URL="http://localhost:3000"

# Email (sign-up confirmation links). SMTP connection string, e.g.
#   smtp://USER:PASSWORD@smtp.example.com:587   or   smtps://USER:PASSWORD@smtp.example.com:465
# Required in production. In development, if unset, emails go to the local dev mailbox: http://localhost:3000/dev/mailbox
EMAIL_SERVER=""
EMAIL_FROM="EcoQuest PH <no-reply@your-domain.ph>"

# Optional: where uploaded proof media is stored (default: ./storage/uploads)
# MEDIA_ROOT=""

# Optional: max DB connections in the pool (default 10)
# DATABASE_POOL_MAX=""

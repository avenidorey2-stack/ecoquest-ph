# Copy to .env and fill in.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ecoquest?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Public URL of the app. Required in production: used in confirmation-email and invite links.
AUTH_URL="http://localhost:3000"

# Email (sign-up confirmation links). SMTP connection string, e.g.
#   smtp://USER:PASSWORD@smtp.example.com:587   or   smtps://USER:PASSWORD@smtp.example.com:465
# Required in production. In development, if unset, emails go to the local dev mailbox: http://localhost:3000/dev/mailbox
EMAIL_SERVER=""
EMAIL_FROM="EcoQuest PH <no-reply@your-domain.ph>"

# Uploaded proof media and avatars. Required on serverless hosts (e.g. Vercel), whose disk is
# not persistent: with both set, files go to a private Supabase Storage bucket (created on first use).
# SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="ecoquest"

# Optional, local disk only: where uploads are stored (default: ./storage/uploads, ./storage/avatars)
# MEDIA_ROOT=""
# AVATAR_ROOT=""

# Optional: max DB connections in the pool (default 10)
# DATABASE_POOL_MAX=""
